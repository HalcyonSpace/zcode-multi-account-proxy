# Copy to .env and edit:  cp .env.example .env
# Full reference: docs/ENVIRONMENT.md

# REQUIRED - key clients must send as "Authorization: Bearer <key>".
# Generate: openssl rand -base64 32
PROXY_API_KEY=change-me

# REQUIRED - encrypts the saved login. Keep it stable; changing it forces a new sign-in.
# Generate: openssl rand -base64 32
CREDENTIAL_SECRET=change-me

# Host ports
PROXY_PORT=8080
DASHBOARD_PORT=39777
